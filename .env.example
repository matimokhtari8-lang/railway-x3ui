# توکن ربات از @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# آدرس کامل پنل، بدون اسلش آخر
PANEL_URL=https://yourdomain.up.railway.app

# مسیر پایه‌ی پنل (همون webBasePath تنظیم‌شده در x-ui)
PANEL_BASE_PATH=/managepanel/

# یوزرنیم/پسورد ادمین پنل
PANEL_USERNAME=admin
PANEL_PASSWORD=change_this_password

# آی‌دی اینباند از قبل ساخته‌شده در پنل (عدد، از URL پنل یا API قابل مشاهده‌ست)
INBOUND_ID=1

# آی‌دی عددی تلگرام ادمین‌ها، با کاما جدا شود
ADMIN_IDS=111111111,222222222

# نام سرویس که در پیام‌ها و ریمارک کانفینگ‌ها نشون داده می‌شه
SERVICE_NAME=MyVPN

# SNI / هاست همون چیزی که روی اینباند گذاشتید (دامنه‌ی Railway یا دامنه‌ی خودتون)
SNI_HOST=yourdomain.up.railway.app

# مسیر WebSocket همون چیزی که روی اینباند گذاشتید
WS_PATH=/cdn
